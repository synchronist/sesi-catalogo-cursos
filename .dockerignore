# Contexto permitido explicitamente: código e manifests necessários ao build.
**
!Dockerfile
!.dockerignore
!backend/
!backend/**
!frontend/
!frontend/**
**/bin/
**/obj/
**/node_modules/
**/dist/
**/.env
**/.env.*
**/appsettings.Local.json
**/appsettings.*.local.json
**/Properties/
**/tests/
**/*.user
**/*.pfx
**/*.pem
**/*.key
**/*.sql
**/*.dump
**/*.log
**/.git/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite3
**/*.sqlite-*
**/*.backup
**/*.bak
**/*.tmp
**/secrets.json
**/.neon
**/.neon.*
**/.neon/
